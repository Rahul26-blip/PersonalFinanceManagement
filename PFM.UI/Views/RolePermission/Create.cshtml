@model PFM.UI.Models.RolePermissionModel
@{
    ViewData["Title"] = "Assign Permission";
}

<div class="pfm-page-toolbar">
    <h2>Assign Permission</h2>
    <a asp-action="Index" class="btn btn-outline-secondary">← Back to Role Permissions</a>
</div>

<div class="pfm-list-card">
    <div class="card-body p-4">
        <form asp-action="Create" method="post" class="pfm-form">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row">
                <div class="col-12">
                    <label asp-for="RoleId" class="form-label">Role ID</label>
                    <input asp-for="RoleId" type="number" class="form-control" />
                    <span asp-validation-for="RoleId" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="PermissionId" class="form-label">Permission ID</label>
                    <input asp-for="PermissionId" type="number" class="form-control" />
                    <span asp-validation-for="PermissionId" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label class="form-label">Status</label>
                    <div class="form-check form-switch">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label">Active</label>
                    </div>
                </div>
            </div>

            <hr />
            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-light">Cancel</a>
                <button type="submit" class="btn btn-primary">✓ Assign Permission</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
