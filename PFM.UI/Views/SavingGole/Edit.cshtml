@model PFM.UI.Models.SavingGoleModel
@{
    ViewData["Title"] = "Edit Saving Goal";
}

<div class="pfm-page-toolbar">
    <h2>Edit Saving Goal</h2>
    <a asp-action="Index" class="btn btn-outline-secondary">← Back to Saving Goals</a>
</div>

<div class="pfm-list-card">
    <div class="card-body p-4">
        <form asp-action="Edit" method="post" class="pfm-form">
            <input asp-for="SavingsGolesId" type="hidden" />
            <input asp-for="CreatedOn" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row">
                <div class="col-12">
                    <label asp-for="UserId" class="form-label">User ID</label>
                    <input asp-for="UserId" type="number" class="form-control" />
                    <span asp-validation-for="UserId" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="GoleName" class="form-label">Goal Name</label>
                    <input asp-for="GoleName" class="form-control" />
                    <span asp-validation-for="GoleName" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="TargetAmount" class="form-label">Target Amount</label>
                    <input asp-for="TargetAmount" type="number" class="form-control" />
                    <span asp-validation-for="TargetAmount" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="CurrentAmount" class="form-label">Current Amount</label>
                    <input asp-for="CurrentAmount" type="number" class="form-control" />
                    <span asp-validation-for="CurrentAmount" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="TargetDate" class="form-label">Target Date</label>
                    <input asp-for="TargetDate" type="date" class="form-control" />
                    <span asp-validation-for="TargetDate" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label class="form-label">Completed</label>
                    <div class="form-check form-switch">
                        <input asp-for="IsCompleted" class="form-check-input" />
                        <label asp-for="IsCompleted" class="form-check-label">Goal completed</label>
                    </div>
                </div>
                <div class="col-12">
                    <label class="form-label">Status</label>
                    <div class="form-check form-switch">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label">Active</label>
                    </div>
                </div>
            </div>

            <hr />
            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-light">Cancel</a>
                <button type="submit" class="btn btn-primary">✓ Update Goal</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
