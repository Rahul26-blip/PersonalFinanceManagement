@model PFM.UI.Models.InvestmentModel
@{
    ViewData["Title"] = "Edit Investment";
}

<div class="pfm-page-toolbar">
    <h2>Edit Investment</h2>
    <a asp-action="Index" class="btn btn-outline-secondary">← Back to Investments</a>
</div>

<div class="pfm-list-card">
    <div class="card-body p-4">
        <form asp-action="Edit" method="post" class="pfm-form">
            <input asp-for="InvestmentId" type="hidden" />
            <input asp-for="CreatedOn" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row">
                <div class="col-12">
                    <label asp-for="UserId" class="form-label">User ID</label>
                    <input asp-for="UserId" type="number" class="form-control" />
                    <span asp-validation-for="UserId" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="InvestmentName" class="form-label">Investment Name</label>
                    <input asp-for="InvestmentName" class="form-control" />
                    <span asp-validation-for="InvestmentName" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="InvestmentType" class="form-label">Investment Type</label>
                    <input asp-for="InvestmentType" class="form-control" />
                    <span asp-validation-for="InvestmentType" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="InvestedAmount" class="form-label">Invested Amount</label>
                    <input asp-for="InvestedAmount" type="number" class="form-control" />
                    <span asp-validation-for="InvestedAmount" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="CurrentValue" class="form-label">Current Value</label>
                    <input asp-for="CurrentValue" type="number" class="form-control" />
                    <span asp-validation-for="CurrentValue" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="InvestmentDate" class="form-label">Investment Date</label>
                    <input asp-for="InvestmentDate" type="date" class="form-control" />
                    <span asp-validation-for="InvestmentDate" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label class="form-label">Status</label>
                    <div class="form-check form-switch">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label">Active</label>
                    </div>
                </div>
            </div>

            <hr />
            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-light">Cancel</a>
                <button type="submit" class="btn btn-primary">✓ Update Investment</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
