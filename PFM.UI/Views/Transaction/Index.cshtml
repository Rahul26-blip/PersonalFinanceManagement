
@model List<PFM.UI.Models.TransactionModel>

@{
    ViewData["Title"] = "Transactions";
}

<div class="pfm-page-toolbar">
    <h2>Transactions</h2>
    <a asp-action="Create" class="pfm-create-btn">
        <i class="bi bi-plus-lg"></i> Create Transaction
    </a>
</div>

<div class="pfm-list-card">
    <div class="table-responsive">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>Transaction ID</th>
                    <th>User ID</th>
                    <th>Account ID</th>
                    <th>Category ID</th>
                    <th>Description</th>
                    <th>Type</th>
                    <th>Amount</th>
                    <th>Transaction Date</th>
                    <th>Active</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.TransactionId</td>
                            <td>@item.UserId</td>
                            <td>@item.AccountId</td>
                            <td>@item.CategoriesId</td>
                            <td>@item.Description</td>
                            <td>@item.TransactionType</td>
                            <td>₹@item.Amount.ToString("N2")</td>
                            <td>@item.TransactionDate.ToString("dd MMM yyyy")</td>
                            <td>
                                <span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">
                                    @(item.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td>
                                <div class="d-flex gap-2">
                                    <a asp-action="Edit" asp-route-Id="@item.TransactionId"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-danger"
                                            data-bs-toggle="modal"
                                            data-bs-target="#deleteTransaction-@item.TransactionId">
                                        <i class="bi bi-trash"></i> Delete
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                            No transactions found. Click Create Transaction to add one.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model != null)
{
    @foreach (var item in Model)
    {
        <div class="modal fade" id="deleteTransaction-@item.TransactionId" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Delete Transaction</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        Are you sure you want to delete this transaction?
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                        <form asp-action="Delete" method="post">
                            <input type="hidden" name="Id" value="@item.TransactionId" />
                            <button type="submit" class="btn btn-danger">Yes, Delete</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
}
