@model List<PFM.UI.Models.AccountModel>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}


<div class="pfm-page-toolbar">
    <h2>Accounts</h2>
    <a asp-action="Create" class="pfm-create-btn">
        <i class="bi bi-plus-lg"></i> Create Account
    </a>
</div>

<div class="pfm-list-card">
    <div class="table-responsive">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>Account ID</th>
                    <th>UserId</th>
                    <th>Account Name</th>
                    <th>Account Type</th>
                    <th>Current Balance</th>
                    <th>Active</th>
                    <th>Created On</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.AccountId</td>
                            <th>@item.UserId</th>
                            <td>@item.AccountName</td>
                            <td>@item.AccountType</td>
                            <td>@item.CurrentBalance.ToString("N2")</td>
                            <td>
                                <span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">
                                    @(item.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td>@item.CreatedOn.ToString("dd MMM yyyy")</td>
                            <td>
                                <div class="d-flex gap-2">
                                    <a asp-action="Edit"
                                       asp-route-Id="@item.AccountId"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>

                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger"
                                            data-bs-toggle="modal"
                                            data-bs-target="#deleteAccount-@item.AccountId">
                                        <i class="bi bi-trash"></i> Delete
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                            No accounts found. Click Create Account to add one.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model != null)
{
    @foreach (var item in Model)
    {
        <div class="modal fade" id="deleteAccount-@item.AccountId" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Delete Account</h5>
                        <button type="button" class="btn-close"
                                data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        Are you sure you want to delete
                        <strong>@item.AccountName</strong>?
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-light"
                                data-bs-dismiss="modal">
                            Cancel
                        </button>
                        <form asp-action="Delete" method="post">
                            <input type="hidden" name="Id" value="@item.AccountId" />
                            <button type="submit" class="btn btn-danger">
                                Yes, Delete
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
}
