@model PFM.UI.Models.RoleModel

<form asp-controller="Role" asp-action="Edit" method="post">

    <input asp-for="RoleId" type="hidden" />
    <input asp-for="CreatedOn" type="hidden" />

    <div class="mb-3">
        <label asp-for="RoleName" class="form-label"></label>
        <input asp-for="RoleName" class="form-control" />
        <span asp-validation-for="RoleName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="RoleCode" class="form-label"></label>
        <input asp-for="RoleCode" class="form-control" />
        <span asp-validation-for="RoleCode" class="text-danger"></span>
    </div>

    <div class="form-check mb-3">
        <input asp-for="IsActive" class="form-check-input" />
        <label asp-for="IsActive" class="form-check-label"></label>
    </div>

    <button type="submit" class="btn btn-primary">Update</button>
    <a asp-controller="Role" asp-action="Index"
       class="btn btn-secondary">Cancel</a>

</form>