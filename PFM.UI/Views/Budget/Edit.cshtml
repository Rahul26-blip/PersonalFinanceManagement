@model PFM.UI.Models.BudgetModel

@{
    ViewData["Title"] = "Edit Budget";
}

<div class="pfm-page-toolbar">
    <h2>Edit Budget</h2>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Back to Budgets
    </a>
</div>

<div class="pfm-list-card">
    <div class="card-body p-4">
        <form asp-action="Edit" method="post" class="pfm-form">
            <input asp-for="BudgetId" type="hidden" />
            <input asp-for="CreatedOn" type="hidden" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-4">
                <div class="col-md-6">
                    <label asp-for="UserId" class="form-label">User ID</label>
                    <input asp-for="UserId" type="number" class="form-control" />
                    <span asp-validation-for="UserId" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="CategoriesId" class="form-label">Category ID</label>
                    <input asp-for="CategoriesId" type="number" class="form-control" />
                    <span asp-validation-for="CategoriesId" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Amount" class="form-label">Budget Amount</label>
                    <input asp-for="Amount" type="number" class="form-control" />
                    <span asp-validation-for="Amount" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="StartDate" class="form-label">Start Date</label>
                    <input asp-for="StartDate" type="date" class="form-control" />
                    <span asp-validation-for="StartDate" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="EndDate" class="form-label">End Date</label>
                    <input asp-for="EndDate" type="date" class="form-control" />
                    <span asp-validation-for="EndDate" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label class="form-label d-block">Status</label>
                    <div class="form-check form-switch mt-2">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label">Active</label>
                    </div>
                </div>
            </div>

            <hr class="my-4" />

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-light">Cancel</a>
                <button type="submit" class="btn btn-primary px-4">
                    <i class="bi bi-check-lg"></i> Update Budget
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
