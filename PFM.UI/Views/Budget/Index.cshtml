
@model List<PFM.UI.Models.BudgetModel>

<div class="pfm-page-toolbar">
    <h2>Budgets</h2>

    <a asp-action="Create" class="pfm-create-btn">
        <i class="bi bi-plus-lg"></i> Create Budget
    </a>
</div>

<div class="pfm-list-card">
    <div class="table-responsive">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>Budget ID</th>
                    <th>User ID</th>
                    <th>Category ID</th>
                    <th>Amount</th>
                    <th>Start Date</th>
                    <th>End Date</th>
                    <th>Active</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.BudgetId</td>
                            <td>@item.UserId</td>
                            <td>@item.CategoriesId</td>
                            <td>₹@item.Amount.ToString("N2")</td>
                            <td>@item.StartDate.ToString("dd MMM yyyy")</td>
                            <td>@item.EndDate.ToString("dd MMM yyyy")</td>

                            <td>
                                <span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">
                                    @(item.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>

                            <td>
                                <div class="d-flex gap-2">
                                    <a asp-action="Edit"
                                       asp-route-Id="@item.BudgetId"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>

                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger"
                                            data-bs-toggle="modal"
                                            data-bs-target="#deleteBudget-@item.BudgetId">
                                        <i class="bi bi-trash"></i> Delete
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                            No budgets found. Click Create Budget to add one.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model != null)
{
    @foreach (var item in Model)
    {
        <div class="modal fade"
             id="deleteBudget-@item.BudgetId"
             tabindex="-1">

            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">

                    <div class="modal-header">
                        <h5 class="modal-title">Delete Budget</h5>
                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal">
                        </button>
                    </div>

                    <div class="modal-body">
                        Are you sure you want to delete this budget?
                    </div>

                    <div class="modal-footer">
                        <button type="button"
                                class="btn btn-light"
                                data-bs-dismiss="modal">
                            Cancel
                        </button>

                        <form asp-action="Delete" method="post">
                            <input type="hidden"
                                   name="Id"
                                   value="@item.BudgetId" />

                            <button type="submit" class="btn btn-danger">
                                Yes, Delete
                            </button>
                        </form>
                    </div>

                </div>
            </div>
        </div>
    }
}
