@model PFM.UI.Models.UserModel
@{
    ViewData["Title"] = "Edit User";
}

<div class="pfm-page-toolbar">
    <h2>Edit User</h2>
    <a asp-action="Index" class="btn btn-outline-secondary">← Back to Users</a>
</div>

<div class="pfm-list-card">
    <div class="card-body p-4">
        <form asp-action="Edit" method="post" class="pfm-form">
            <input asp-for="UserId" type="hidden" />
            <input asp-for="CreatedOn" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row">
                <div class="col-12">
                    <label asp-for="UserName" class="form-label">User Name</label>
                    <input asp-for="UserName" class="form-control" />
                    <span asp-validation-for="UserName" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="UserCode" class="form-label">User Code</label>
                    <input asp-for="UserCode" class="form-control" />
                    <span asp-validation-for="UserCode" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label class="form-label">Status</label>
                    <div class="form-check form-switch">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label">Active</label>
                    </div>
                </div>
            </div>

            <hr />
            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-light">Cancel</a>
                <button type="submit" class="btn btn-primary">✓ Update User</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
